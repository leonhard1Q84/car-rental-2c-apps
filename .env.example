# 留空时使用来源仓库的本地演示适配器。
# 对接共同后端时填写 API Base URL，服务端需配置认证和 CORS。
# VITE_ 变量会进入浏览器构建产物，不得在这里放置服务端密钥。
VITE_CUSTOMER_SELF_SERVICE_API_BASE_URL=

# 客户统一鉴权服务。留空时订单验证沿用本地演示匹配，不签发会话 token。
VITE_CUSTOMER_AUTH_API_BASE_URL=

# 续租独立服务源。须支持 FULL_RENTAL_V2；相关 API 均留空时使用指定账号的模拟场景。
# 本仓库不含后端，不要将其他无关服务作为模拟成功来源。
VITE_RENTAL_EXTENSION_API_BASE_URL=
